# Non-secret local-dev defaults for docker-compose.yml. Copy to .env before `docker
# compose up`. Real secrets never go here — see docs/specs/14-env-secrets.md for what
# belongs in Vault instead (Stripe keys, webhook secrets, JWT secret in staging/prod).

POSTGRES_DB=medusa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Dev-only stand-ins for Vault-managed secrets (see docs/specs/14-env-secrets.md).
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret

# Filled in once Phase 1 creates the two sales channels (docs/specs/01-medusa-config.md).
BRAND_A_PUBLISHABLE_KEY=pk_brand_a
BRAND_B_PUBLISHABLE_KEY=pk_brand_b

# Only read when running `docker compose --profile twenty up` (docs/specs/
# 07-twenty-data-model.md) — every other service ignores these.
# TWENTY_DB_PASSWORD=twenty
# TWENTY_SERVER_URL=http://localhost:3000
# TWENTY_APP_SECRET=  # generate a real secret before anything beyond local experimentation
