# Both storefronts (Brand A on 8000, Brand B on 8001) hit this one backend.
STORE_CORS=http://localhost:8000,http://localhost:8001,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/medusa
DB_NAME=medusa

# Sales channel / region config — populated once Phase 1 creates them (docs/specs/01-medusa-config.md)
SALES_CHANNEL_BRAND_A_ID=
SALES_CHANNEL_BRAND_B_ID=

# Twenty CRM sync (Phase 5 — see docs/specs/08-integration-webhooks.md). Outbound
# sync (order.placed -> Twenty) is a no-op, logged and skipped, unless
# TWENTY_WEBHOOK_URL is set — so this stays safe to leave blank in any
# environment without a real Twenty instance (this repo's CI and local dev
# both fall in that bucket today, same as Stripe below).
TWENTY_WEBHOOK_URL=
TWENTY_OUTBOUND_WEBHOOK_SECRET=
TWENTY_INBOUND_WEBHOOK_SECRET=
TWENTY_API_TOKEN=

# Stripe (Phase 2, not wired up yet — see docs/specs/04-payments.md)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
