# Copy to .env (gitignored via the root .gitignore's *.env rule) and fill in real
# values. Never commit a populated .env - in staging/prod these come from Vault
# instead (secret/medusa-twenty/<env>/telegram-bot-token, .../telegram-chat-id),
# per docs/specs/14-env-secrets.md.

TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# name=url pairs, comma-separated. Point these at the backend/storefronts on
# whichever EC2 host or load balancer is currently serving traffic.
TARGETS=backend=http://localhost:9000/health,storefront-a=http://localhost:8000/,storefront-b=http://localhost:8001/

# Optional: also watch ECS services and EC2 instances directly (needs AWS creds
# available to the container, e.g. an instance profile or mounted credentials -
# short-lived, via Vault, same as the Jenkins deploy stages).
# AWS_REGION=us-east-1
# ECS_CLUSTER=medusa-twenty-staging
# ECS_SERVICES=backend,storefront-a,storefront-b
# EC2_INSTANCE_IDS=i-0123456789abcdef0

CHECK_INTERVAL_SECONDS=60
FAILURE_THRESHOLD=3
STATE_FILE=/data/state.json
LOG_LEVEL=INFO
